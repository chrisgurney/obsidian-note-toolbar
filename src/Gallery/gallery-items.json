  {
    "id": "cycle-themes",
    "icon": "venetian-mask",
    "script": "const i = ntb.getActiveItem();\nconst t = [...Object.values(ntb.app.customCss.themes), { name: '' }];\nconst n = t[(t.findIndex(theme => theme.name === ntb.app.vault.getConfig('cssTheme')) + 1) % t.length].name;\nntb.app.customCss.setTheme(n);\nif (n) new Notice(n);",
    "type": "javascript"
  },
  {
    "id": "cycle-workspace",
    "icon": "layout-grid",
    "script": "const p = ntb.app.internalPlugins.getPluginById('workspaces');\nconst ws = Object.keys(p?.instance.workspaces);\nconst a = p?.instance.activeWorkspace;\nconst i = (ws.indexOf(a) + 1) % ws.length;\np?.instance.loadWorkspace(ws[i]);\nnew Notice(ws[i]);",
    "type": "javascript"
  },
