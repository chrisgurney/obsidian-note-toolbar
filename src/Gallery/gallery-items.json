  {
    "id": "file-next",
    "icon": "square-arrow-right",
    "script": "const go = s => { const cf = app.workspace.getActiveFile(), fs = cf?.parent?.children?.filter(f => !f.children).sort((a, b) => a.basename.localeCompare(b.basename, undefined, {numeric: true, sensitivity: 'base'})) || [], ci = fs.findIndex(f => f.path === cf.path); if (fs.length > 1) app.workspace.activeLeaf.openFile(fs[((ci + s) % fs.length + fs.length) % fs.length]); }; go(1);",
    "type": "javascript"
  },
  {
    "id": "file-prev",
    "icon": "square-arrow-left",
    "script": "const go = s => { const cf = app.workspace.getActiveFile(), fs = cf?.parent?.children?.filter(f => !f.children).sort((a, b) => a.basename.localeCompare(b.basename, undefined, {numeric: true, sensitivity: 'base'})) || [], ci = fs.findIndex(f => f.path === cf.path); if (fs.length > 1) app.workspace.activeLeaf.openFile(fs[((ci + s) % fs.length + fs.length) % fs.length]); }; go(-1);",
    "type": "javascript"
  },
