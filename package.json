{
  "name": "obsidian-note-toolbar",
  "version": "1.36.11",
  "releaseVersion": "1.36",
  "settingsVersion": 20260812.1,
  "description": "Obsidian plugin that adds customizable toolbars to your notes.",
  "main": "main.js",
  "scripts": {
    "analyze": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs analyze",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "build:skills": "node build/copy-skill-references.mjs",
    "check": "npm run lint && npm run typecheck && npm run stylelint && npm run build",
    "check:install": "npm ci --dry-run",
    "check:skills": "node build/copy-skill-references.mjs --check",
    "dev": "npm run prebuild && node esbuild.config.mjs",
    "docs": "node build/docs.mjs",
    "docs:watch": "node build/docs.mjs --watch",
    "lint": "npx eslint .",
    "prebuild": "node build/generate-version.mjs",
    "prelint": "node build/generate-version.mjs",
    "pretypecheck": "node build/generate-version.mjs",
    "release": "node build/release.mjs",
    "stylelint": "npx stylelint '**/*.css'",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [],
  "author": "Chris Gurney",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/sortablejs": "^1.15.8",
    "chokidar": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.14.4",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@codemirror/view": "6.43.13",
    "sortablejs": "^1.15.2"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
